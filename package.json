{
  "name": "edgeever-safe-html-reader",
  "version": "1.0.2",
  "description": "A safe Markdown and allowlisted HTML reading view for EdgeEver.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
